<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- تم اصلی بدون ActionBar پیش‌فرض سیستم — چون همه Activityها از Toolbar خودشون استفاده می‌کنن -->
    <style name="Theme.BazdidTrans" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- نگه داشته شده برای سازگاری (در صورت نیاز جداگانه) -->
    <style name="Theme.BazdidTrans.NoActionBar" parent="Theme.BazdidTrans">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
